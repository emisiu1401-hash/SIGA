{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/siga/contracts/interpretacao.v1.json",
  "title": "SIGA — Resultado estruturado da interpretação (proposta, sem comando de escrita)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "language", "menu_id", "intentions", "facts", "clarification_questions", "requires_human_review", "notes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "language": {"const": "pt-BR"},
    "menu_id": {"type": ["string", "null"]},
    "intentions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target", "date", "person_reference", "justification", "conditions", "evidence_excerpt", "declared_only"],
        "properties": {
          "type": {"enum": ["ASSIGN","INITIAL_DUE_DATE","CONFIRM_DUE_DATE","REQUEST_EXTENSION","REQUEST_TRANSFER","REQUEST_SUPPORT","REPORT_BLOCKER","DECLARE_STAGE_COMPLETE","PROPOSE_CHILD_DEMAND","APPROVE_WITHOUT_RESERVATIONS","APPROVE_WITH_RESERVATIONS","REJECT","ASK_CLARIFICATION","OTHER_INSTRUCTION","ASK_QUESTION","NO_ACTION"]},
          "target": {"type": ["string", "null"]},
          "date": {"type": ["string", "null"], "description": "ISO local YYYY-MM-DD; null se impossível ancorar sem ambiguidade"},
          "person_reference": {"type": ["string", "null"]},
          "justification": {"type": ["string", "null"]},
          "conditions": {"type": ["string", "null"]},
          "evidence_excerpt": {"type": "string", "maxLength": 600},
          "declared_only": {"type": "boolean"}
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "value", "source", "verification"],
        "properties": {
          "field": {"type": "string"},
          "value": {"type": ["string", "number", "boolean", "null"]},
          "source": {"type": "string"},
          "verification": {"enum": ["DECLARADO", "VERIFICADO", "NAO_VERIFICADO"]}
        }
      }
    },
    "clarification_questions": {"type": "array", "items": {"type": "string"}},
    "requires_human_review": {"type": "boolean"},
    "notes": {"type": "string"}
  }
}
